# ---- App ----
APP_ENV=dev
DATABASE_URL=sqlite:///./wapas.db
# Public URL Paytm can reach (ngrok / cloudflared). Needed for webhooks.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# ---- Paytm (test / staging) ----
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_BASE_URL=https://securegw-stage.paytm.in

# ---- Sarvam ----
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# ---- Telegram owner channel ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---- Security ----
# generate: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SIGNING_SECRET=change-me

# ---- Policy ----
AUTO_LIMIT_INR=5000
MAX_REMINDERS=2
MIN_CONFIDENCE=0.7
