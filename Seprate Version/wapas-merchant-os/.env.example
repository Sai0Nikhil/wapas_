# Copy to .env for an isolated local development install. Optional providers with
# missing settings report NOT CONFIGURED; they do not silently become live services.
# Check what is really connected with:  python -m app.doctor

# ---- Mode -------------------------------------------------------------
# fake   = simulated gateway for development/tests only; production startup rejects it
# paytm  = Paytm adapter; staging payment actions also require PAYTM_TEST_ENABLED=true
WAPAS_ENV=development
GATEWAY=fake

# ---- Paytm (test environment: dashboard > Developer Settings > API Keys > Test) ----
# Keep PAYTM_TEST_ENABLED false unless test transaction initiation is intentionally enabled in non-production.
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_HOST=https://securestage.paytmpayments.com
# Test transaction initiation is off unless explicitly enabled outside production.
PAYTM_TEST_ENABLED=false
PAYTM_LIVE_ENABLED=false
PAYTM_LINK_CREATE_PATH=/link/create
PAYTM_LINK_FETCH_TXN_PATH=/link/fetchTransaction
PAYTM_ORDER_STATUS_PATH=/v3/order/status
# A public HTTPS URL for storefront QR verification and Paytm status callbacks.
# Never expose the owner console through a public tunnel.
PUBLIC_BASE_URL=http://localhost:8000

# ---- The agent's brain (any OpenAI-compatible chat API; empty = rule reasoner) ----
# Sarvam (recommended for the hackathon):
#   LLM_BASE_URL=https://api.sarvam.ai/v1
#   LLM_API_KEY=<same key as SARVAM_API_KEY>
#   LLM_MODEL=sarvam-105b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# off = fast (1-4 s per call). low/high make Sarvam think first: 30-60 s per call.
LLM_REASONING_EFFORT=off
# Cases decided at once. Sarvam Starter allows 40 chat requests/min; each case takes 2-5 calls.
LLM_PARALLEL=3

# ---- Sarvam voice (dashboard.sarvam.ai > API keys); empty = text answers ----
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# ---- Counter image recognition (off unless explicitly enabled) ----------------
# Uses an OpenAI-compatible /chat/completions endpoint. Configure separately from
# the recovery agent's LLM. The owner must also consent per uploaded image.
WAPAS_VISION_ENABLED=false
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---- Telegram: the teammate on your phone (optional) ---------------------
# 1. In Telegram, message @BotFather: /newbot  -> copy the token here.
# 2. Each phone sends /start to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy each "chat":{"id": ...}.
# Owner chat: approvals with buttons, recovery notes, questions by text or voice.
# Customer chat: a second phone that receives what customers would receive; reply STOP to opt out.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_CUSTOMER_CHAT_ID=
# Only if the owner chat is a GROUP (negative id): the owner's own user id. Otherwise nobody can approve.
TELEGRAM_OWNER_USER_ID=

# ---- Owner approvals ---------------------------------------------------------
# Approve/Skip buttons carry an HMAC token bound to the case's current decision.
# Set a long random value so buttons survive a restart (empty = new secret each run).
APPROVAL_SECRET=
# Unanswered approval requests close after this many hours, contacting nobody.
APPROVAL_TTL_HOURS=12

# ---- n8n (optional): every outbound customer message is also POSTed here ----
N8N_WEBHOOK_URL=

# ---- Tuning -------------------------------------------------------------
DATABASE_URL=sqlite:///./wapas-development.db
WAPAS_ALLOW_PROTECTED_DB_WRITES=false
MERCHANT_NAME=Wapas Store
REMINDER_AFTER_SECONDS=120
WORKER_TICK_SECONDS=2
TIMEZONE=Asia/Kolkata
STATUS_POLL_SECONDS=8
# Leave empty except for an isolated local demo.
CLOCK_OVERRIDE=
# The recovery policy file is local application configuration.
POLICY_FILE=policy.yaml
# When the agent recommends "later" for a live case (e.g. the customer closed the checkout
# a moment ago), the first message waits this long. 1800 = 30 min; use ~20 for a stage demo.
AGENT_DELAY_SECONDS=1800
# Research batches only (simulated customers): Thompson sampling on send timing.
# Live customers are never experimented on, whatever this says.
LEARNING=true
WAIT_ARM_SECONDS=20
